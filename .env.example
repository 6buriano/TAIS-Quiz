# Configuración del modelo de lenguaje local (opcional).
# Copiá este archivo como `.env` en la raíz y ajustá los valores.
# Sin este archivo, la corrección de desarrollo usa criterios y palabras clave.

# auto = detecta Ollama (:11434) o un servidor compatible con OpenAI (:1234); también: ollama, openai, ninguno
QUIZ_LLM_PROVEEDOR=auto

# URL base del servidor de modelos (dejalo vacío para autodetección)
# Ollama:     http://localhost:11434
# LM Studio:  http://localhost:1234/v1
# llama.cpp:  http://localhost:8080/v1
QUIZ_LLM_URL=

# Nombre exacto del modelo tal como figura en el servidor
QUIZ_LLM_MODELO=qwen2.5:7b-instruct

# Solo si tu servidor pide autenticación
QUIZ_LLM_API_KEY=

# Segundos de espera por corrección (los modelos locales pueden tardar)
QUIZ_LLM_TIMEOUT=180

# auto = usa el modelo si está; llm = exige modelo; heuristica = nunca usa IA
QUIZ_CORRECTOR=auto
